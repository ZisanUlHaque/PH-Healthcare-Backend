<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset Successful</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f4f4f4;
        color: #333;
        margin: 0;
        padding: 0;
      }
      .wrapper {
        max-width: 600px;
        margin: 30px auto;
        background: #ffffff;
        border: 2px solid #b8e0e0;
        border-radius: 10px;
        overflow: hidden;
      }
      .header {
        background: #b8e0e0;
        text-align: center;
        padding: 20px;
      }
      .header h2 {
        margin: 0;
        color: #0a2a3a;
        font-size: 20px;
      }
      .content {
        padding: 30px;
      }
      .content h3 {
        margin-top: 0;
        color: #000;
      }
      .content p {
        font-size: 15px;
        line-height: 1.6;
        color: #333;
      }
      .success-box {
        background: #eaf6f6;
        padding: 25px;
        text-align: center;
        border-radius: 6px;
        margin: 20px 0;
      }
      .success-icon {
        display: inline-block;
        width: 60px;
        height: 60px;
        line-height: 60px;
        border-radius: 50%;
        background: #e6f7ec;
        border: 2px solid #17a34a;
        color: #17a34a;
        font-size: 30px;
        font-weight: bold;
      }
      .success-text {
        margin-top: 12px;
        font-size: 16px;
        font-weight: bold;
        color: #17a34a;
      }
      .support {
        font-size: 13px;
        color: #666;
        font-style: italic;
      }
      .support a {
        color: #17a2b8;
        text-decoration: underline;
      }
      .note {
        font-size: 13px;
        color: #666;
        font-style: italic;
        margin-top: 15px;
      }
      .regards {
        margin-top: 25px;
        font-size: 14px;
      }
      .divider {
        border-top: 1px solid #ddd;
        margin: 25px 0;
      }
      .footer {
        text-align: center;
        padding: 10px 20px 25px;
      }
      .footer .brand {
        font-size: 20px;
        font-weight: bold;
        color: #17a2b8;
        margin-bottom: 10px;
      }
      .footer p {
        font-size: 12px;
        color: #666;
        margin: 5px 0;
      }
      .footer a {
        color: #17a2b8;
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="header">
        <h2>Password Reset Successful</h2>
      </div>

      <div class="content">
        <h3>Hi <%= name %>,</h3>
        <p>Your password has been changed successfully.</p>

        <div class="success-box">
          <div class="success-icon">&#10003;</div>
          <div class="success-text">Password Updated Successfully</div>
        </div>

        <p>
          You can now log in to your PH Healthcare System account using your
          new password.
        </p>

        <p class="support">
          If you did not make this change, please contact support immediately.<br />
          <a href="mailto:support@ph-healthcare-system.com">support@ph-healthcare-system.com</a>
        </p>

        <p class="note">Note: This is a system generated message. Do not reply.</p>

        <div class="regards">
          Best Regards,<br />
          <strong>Team PH Healthcare</strong>
        </div>

        <div class="divider"></div>
      </div>

      <div class="footer">
        <div class="brand">🏥 PH Healthcare System</div>
        <p>
          &copy; <%= new Date().getFullYear() %>
          <a href="https://ph-healthcare-system.com">ph-healthcare-system.com</a>
          &nbsp;|&nbsp;
          <a href="mailto:hello@ph-healthcare-system.com">hello@ph-healthcare-system.com</a>
        </p>
      </div>
    </div>
  </body>
</html>